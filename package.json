{
  "name": "feriados-dev-oss",
  "version": "1.0.0",
  "description": "API de feriados nacionais, estaduais e municipais do Brasil",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run changelog:build && tsx watch src/server.ts",
    "build": "npm run changelog:build && tsc && tsc-alias",
    "changelog:build": "node scripts/build-changelog.mjs",
    "changelog:new": "node scripts/changelog-new.mjs",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "pretest": "node scripts/build-changelog.mjs",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src --ext .ts",
    "prelint": "node scripts/build-changelog.mjs",
    "lint:fix": "eslint src --ext .ts --fix",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migrate": "node scripts/run-sql-migrations.mjs"
  },
  "keywords": [
    "feriados",
    "holidays",
    "brasil",
    "api",
    "rest"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pg": "^8.11.3",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
